# Development defaults may be loaded from a project-root .env file.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://inaba:inaba@localhost:5432/inaba
POSTGRES_IMAGE=pgvector/pgvector:pg17
PYTHON_BASE_IMAGE=python:3.12-slim
POSTGRES_DB=inaba
POSTGRES_USER=inaba
POSTGRES_PASSWORD=replace-with-postgres-password
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=1800
DATABASE_CONNECT_TIMEOUT=10

# OpenAI-compatible chat endpoint. Use production secrets outside Git.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://llm.example.com/v1
LLM_API_KEY=replace-with-llm-api-key
LLM_MODEL=gpt-4o-mini
LLM_CONNECT_TIMEOUT=10
LLM_READ_TIMEOUT=60
LLM_MAX_RETRIES=1

# OpenAI-compatible embedding endpoint. It may be a different provider from the LLM.
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=https://embeddings.example.com/v1
EMBEDDING_API_KEY=replace-with-embedding-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_CONNECT_TIMEOUT=10
EMBEDDING_READ_TIMEOUT=30
EMBEDDING_MAX_RETRIES=1

# Required when APP_ENV=production; do not commit a real token.
SERVICE_TOKEN=replace-with-service-token
READINESS_TIMEOUT=5
LOG_LEVEL=INFO
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000

# Override these absolute paths in cloud production as needed.
KNOWLEDGE_DATA_PATH=data/knowledge
KNOWLEDGE_MAX_FILE_BYTES=5242880
BACKUP_PATH=data/backups

# Production container deployment overrides (store real values in /etc/inaba/inaba.env).
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://inaba_app:replace-with-db-password@postgres:5432/inaba
# INABA_POSTGRES_DATA_DIR=/opt/inaba-data/postgres
# INABA_KNOWLEDGE_DATA_DIR=/opt/inaba-data/knowledge
# INABA_BACKUP_DIR=/opt/inaba-backups
# INABA_CORE_PORT=1515
